# Скопируйте в .env и задайте свой ключ (минимум 16 символов).
API_KEY=change-me-to-a-long-random-key
LOG_LEVEL=INFO

# Swagger, ReDoc и /openapi.json (по умолчанию выключены).
API_DOCS_ENABLED=false

# Хосты, которым разрешено резолвиться во внутреннюю сеть (защита от SSRF).
# webhook-sink - тестовый получатель из профиля e2e; в проде оставить пустым.
WEBHOOK_ALLOWED_HOSTS=webhook-sink
